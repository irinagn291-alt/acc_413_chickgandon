    "Baseline: 115 g per hen daily. This is a planning estimate, not a feed formulation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseline: 115 g per hen daily. This is a planning estimate, not a feed formulation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtwert: 115 g je Henne täglich. Eine Planungshilfe, keine Futterrezeptur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Base : 115 g par poule et par jour. Estimation de planification, pas une formule d’aliment."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Base: 115 g por galinha ao dia. Estimativa para planejamento, não uma fórmula de ração."

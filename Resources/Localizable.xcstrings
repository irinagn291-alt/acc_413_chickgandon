          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholte Pflege erzeugt beim Abschließen den nächsten Termin. Bis zu 60 Hinweise werden geplant und beim Öffnen aktualisiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un soin récurrent crée la prochaine échéance une fois terminé. Jusqu’à 60 alertes sont programmées, puis actualisées à l’ouverture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuidados recorrentes criam a próxima data ao concluir. Até 60 alertas são agendados e atualizados ao abrir o app."

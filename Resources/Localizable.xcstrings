  "strings": {
    "0 means once. The next reminder is created when you complete this one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 means once. The next reminder is created when you complete this one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 bedeutet einmalig. Der nächste Termin entsteht beim Abschließen dieses Eintrags."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 signifie une seule fois. Le prochain rappel est créé quand vous terminez celui-ci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "0 significa uma vez. O próximo lembrete é criado ao concluir este."
          }
        }
      }
    },

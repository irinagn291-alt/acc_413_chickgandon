    "For adult laying hens on complete layer feed. Adjust to the feed label, bird condition and local advice.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For adult laying hens on complete layer feed. Adjust to the feed label, bird condition and local advice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für erwachsene Legehennen mit Alleinfutter. An Futteretikett, Tierzustand und örtliche Beratung anpassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les pondeuses adultes nourries avec un aliment complet. Adaptez selon l’étiquette, l’état des oiseaux et les conseils locaux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para poedeiras adultas com ração completa. Ajuste conforme o rótulo, a condição das aves e a orientação local."
          }
        }
      }
    },

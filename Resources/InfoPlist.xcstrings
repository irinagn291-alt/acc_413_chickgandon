{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a portrait to recognize a bird in your flock journal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere einen Vogel, um ihn im Bestandstagebuch zu erkennen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez un portrait pour reconnaître un oiseau dans votre journal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografe uma ave para reconhecê-la no diário do plantel."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an existing bird picture for its flock card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein vorhandenes Vogelfoto für die Bestandskarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une photo existante pour la fiche de l’oiseau."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma foto existente para a ficha da ave."
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy selected poultry care tasks into your Apple Reminders lists."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertrage ausgewählte Pflegeaufgaben in deine Apple-Erinnerungslisten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez les soins choisis dans vos listes Rappels Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie os cuidados selecionados para suas listas do Lembretes da Apple."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save and update the poultry care tasks you choose in Apple Reminders."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere und aktualisiere selbst gewählte Geflügelpflege in Apple Erinnerungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez et actualisez les soins choisis dans Rappels Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve e atualize os cuidados de aves escolhidos no Lembretes da Apple."
          }
        }
      }
    }
  },
  "version": "1.0"
}